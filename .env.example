# Clerk Authentication (Admin accounts only - managed via Clerk Dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001

# API Configuration - Points to bonus-galaxy-new
# For production:
NEXT_PUBLIC_API_URL=https://bonus-galaxy-demo.vercel.app/api
# For local development:
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Note: Database configuration is shared from bonus-galaxy-new
# Make sure bonus-galaxy-new/.env has DATABASE_URL configured
